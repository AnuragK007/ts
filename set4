data(AirPassengers)
x <- log(AirPassengers)

m1 <- arima(x, c(1,1,1))
m2 <- arima(x, c(2,1,1))
m3 <- arima(x, c(0,1,2))

models <- list(m1, m2, m3)

# Compare models
for (m in models) {
  n <- length(x)
  k <- length(m$coef)
  cat("LogLik:", logLik(m), "AIC:", AIC(m),
      "BIC:", BIC(m),
      "FPE:", m$sigma2*(n+k)/(n-k), "\n")
}

# Residuals of best model by AIC
fit <- models[[which.min(sapply(models, AIC))]]
e <- residuals(fit)

acf(e)
hist(e, probability=TRUE)
lines(density(e), col="red")
qqnorm(e)
qqline(e)


library(FinTS)
library(rugarch)

data(AirPassengers)
x <- log(AirPassengers)

fit <- arima(x, c(1,1,1))
e <- residuals(fit)

Box.test(e, lag=12, type="Ljung-Box")
Box.test(e^2, lag=12, type="Ljung-Box")

test <- ArchTest(e, lags=12)
print(test)

if (test$p.value < 0.05) {
  spec <- ugarchspec(
    variance.model=list(model="sGARCH", garchOrder=c(1,1)),
    mean.model=list(armaOrder=c(0,0), include.mean=FALSE)
  )

  g <- ugarchfit(spec, data=e)
  print(g)
  plot(sigma(g)^2, type="l", main="GARCH Conditional Variance")
}
